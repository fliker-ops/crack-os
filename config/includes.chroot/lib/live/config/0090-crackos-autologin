#!/bin/sh
# Crack OS (solo en modo Live): entra directo al escritorio con el usuario live.
USER_NAME="${LIVE_USERNAME:-crack}"
for a in $(cat /proc/cmdline); do
    case "$a" in username=*) USER_NAME="${a#username=}" ;; esac
done
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/20-live-autologin.conf <<CONF
[Autologin]
User=${USER_NAME}
Session=xfce
CONF
