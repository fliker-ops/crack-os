// Crack OS - fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "/etc/crackos/skull.txt", "color": { "1": "red", "2": "light_red", "3": "red" }, "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "red" }, "key": { "width": 14 } },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "color": { "user": "red", "at": "white", "host": "light_red" } },
    { "type": "custom", "format": "\u001b[90m─────────────── \u001b[31mHARDWARE\u001b[90m ───────────────" },
    { "type": "host", "key": "󰌢  equipo" },
    { "type": "cpu", "key": "󰍛  cpu" },
    { "type": "gpu", "key": "󰍹  gpu" },
    { "type": "memory", "key": "󰘚  memoria" },
    { "type": "disk", "key": "󰋊  disco", "folders": "/" },
    { "type": "battery", "key": "󰁹  bateria" },
    { "type": "custom", "format": "\u001b[90m─────────────── \u001b[31mSOFTWARE\u001b[90m ───────────────" },
    { "type": "os", "key": "󰶨  sistema" },
    { "type": "kernel", "key": "󰢮  kernel" },
    { "type": "wm", "key": "󰖨  entorno" },
    { "type": "packages", "key": "󰏖  paquetes" },
    { "type": "terminal", "key": "󰆍  terminal" },
    { "type": "uptime", "key": "󰅐  encendido" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────────────" },
    { "type": "colors", "symbol": "circle" }
  ]
}
