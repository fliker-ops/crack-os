#!/bin/bash
# Crack OS: diagnostico rapido del escritorio
echo "== sesion: $XDG_SESSION_TYPE / $XDG_CURRENT_DESKTOP  hyprland: $(hyprctl version 2>/dev/null | head -1)"
echo "== monitores: $(hyprctl monitors -j 2>/dev/null | jq -r '.[] | "\(.name) \(.width)x\(.height)"' | tr '\n' ' ')"
echo "== errores de config: $(hyprctl configerrors 2>/dev/null | head -3)"
echo "== procesos: $(for p in waybar swaync swaybg nm-applet swayidle; do pgrep -x $p >/dev/null && printf '%s ✔ ' $p || printf '%s ✘ ' $p; done)"
echo "== tema gtk: $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)"
echo "== modo seguro: $([ -f /etc/crackos/safe-mode-active ] && echo SI || echo no)  llave usb: $(. /etc/crackos/usbkey.conf; echo $ENABLED)"
tail -3 ~/.cache/crackos-session.log 2>/dev/null
