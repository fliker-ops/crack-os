#!/bin/bash
# Crack OS: volumen y brillo con aviso en pantalla.  crackos-osd volume up|down|mute | brightness up|down
case "$1 $2" in
  "volume up")   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  "volume down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  "volume mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "brightness up")   brightnessctl -q set 5%+ ;;
  "brightness down") brightnessctl -q set 5%- ;;
esac
if [ "$1" = volume ]; then
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    p=$(awk '{printf "%d", $2*100}' <<<"$v"); icon=audio-volume-high
    grep -q MUTED <<<"$v" && { p=0; icon=audio-volume-muted; }
    notify-send -t 1200 -h string:x-canonical-private-synchronous:osd -h int:value:"$p" -i $icon "Volumen" "$p%"
else
    p=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d %)
    notify-send -t 1200 -h string:x-canonical-private-synchronous:osd -h int:value:"${p:-0}" -i display-brightness "Brillo" "${p:-0}%"
fi
