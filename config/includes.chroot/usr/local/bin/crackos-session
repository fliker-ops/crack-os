#!/bin/bash
# Crack OS: ajustes al iniciar la sesion de Hyprland
mkdir -p "$HOME/.cache"; exec >>"$HOME/.cache/crackos-session.log" 2>&1; echo "--- $(date)"
SAFE=0; [ -f /etc/crackos/safe-mode-active ] && SAFE=1

# Fondo de pantalla (el de modo seguro lo indica claramente)
WP=$(cat "$HOME/.config/crackos/wallpaper" 2>/dev/null)
[ -f "$WP" ] || WP=/usr/share/backgrounds/crackos/crackos-wallpaper.png
[ "$SAFE" = 1 ] && WP=/usr/share/backgrounds/crackos/crackos-wallpaper-safe.png
pkill -x swaybg; swaybg -m fill -i "$WP" &

# Distribucion de teclado del sistema (la que se eligio al instalar)
if [ -f /etc/default/keyboard ]; then
    . /etc/default/keyboard
    [ -n "$XKBLAYOUT" ] && hyprctl keyword input:kb_layout "$XKBLAYOUT" >/dev/null
    [ -n "$XKBVARIANT" ] && hyprctl keyword input:kb_variant "$XKBVARIANT" >/dev/null
fi

# Tema oscuro para aplicaciones GTK en Wayland
gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme Matcha-dark-aliz 2>/dev/null
gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark 2>/dev/null
gsettings set org.gnome.desktop.interface font-name "JetBrainsMono Nerd Font 10" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-theme Adwaita 2>/dev/null

sleep 3
if [ "$SAFE" = 1 ]; then
    notify-send -u critical -i crackos "MODO SEGURO ACTIVO" \
      "Todo lo que hagas en esta sesión se borrará al reiniciar o apagar."
elif [ ! -f "$HOME/.config/crackos/.bienvenida" ]; then
    notify-send -i crackos "Bienvenido a Crack OS" \
      "Super + Espacio: aplicaciones · Super + Enter: terminal · Super + F1: todos los atajos"
    mkdir -p "$HOME/.config/crackos" && touch "$HOME/.config/crackos/.bienvenida"
fi
