#!/bin/sh
# Crack OS - configuracion de live-build (Debian 13 "trixie", estable)
set -e
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-chroot-security "http://security.debian.org/debian-security/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --security true \
    --updates true \
    --firmware-chroot true \
    --firmware-binary true \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi,syslinux" \
    --memtest none \
    --iso-application "Crack OS" \
    --iso-publisher "Crack OS" \
    --iso-volume "CRACK_OS_1_0" \
    --image-name "crack-os" \
    --bootappend-live "boot=live components quiet splash locales=es_ES.UTF-8 keyboard-layouts=latam timezone=America/Guatemala hostname=crackos username=crack user-fullname=Crack" \
    --cache-packages false \
    "${@}"
